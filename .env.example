NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
# Allowed origins are registered through account signup and stored in MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=universal_tracker
# npm run setup generates a random signing secret in .env.
SESSION_SECRET=
SESSION_TTL_SECONDS=14400
RETENTION_DAYS=30
# Set only to the exact number of trusted reverse-proxy hops.
TRUST_PROXY_HOPS=0

# Video rendering: defaults to installed Google Chrome, otherwise Playwright Chromium.
# CHROME_PATH=/usr/bin/google-chrome
VIDEO_MAX_SECONDS=600
VIDEO_FPS=10
VIDEO_CHROMIUM_SANDBOX=true

# Development-only exact local origins permitted for HTTP 200 availability checks.
# Still requires an HTTP 200 response. Ignored in production.
LOCAL_VERIFICATION_ORIGINS=

# Analytics inactivity timeout, independent of recording-token expiry.
ANALYTICS_SESSION_TIMEOUT_SECONDS=1800

# New videos: webm (VP9, default) or mp4 (H.264). Existing files are preserved.
VIDEO_FORMAT=webm

# Exact origin rules; empty keeps legacy action-based finalization. Tag must load on all result pages.
RECORDING_SUCCESS_RULES='{}'
