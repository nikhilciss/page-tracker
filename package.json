{
  "name": "universal-session-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "db:init": "node scripts/init-db.js",
    "db:prune": "node scripts/prune.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node --test test/browser.e2e.js test/page.e2e.js test/mvc.e2e.js test/profile.e2e.js test/dashboard.e2e.js test/journey.e2e.js test/visitor-identity.e2e.js",
    "check": "node --check public/tracker.js && node --check public/app.js && node --check src/app.js",
    "build": "node scripts/build.js",
    "prestart": "npm run build",
    "predev": "npm run build",
    "test:video": "node --test test/video.e2e.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "ffmpeg-static": "^5.3.0",
    "geoip-lite": "^1.4.10",
    "helmet": "^8.1.0",
    "mysql2": "^3.14.0",
    "playwright": "^1.63.0",
    "rrweb": "^2.1.6",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9"
  }
}
